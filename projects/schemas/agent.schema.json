{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.major.tech/agent.json",
	"title": "Major agent definition",
	"type": "object",
	"properties": {
		"$schema": { "type": "string" },
		"slug": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"name": { "type": "string", "minLength": 1, "maxLength": 100 },
		"description": { "type": "string", "maxLength": 1000 },
		"model": { "type": "string", "minLength": 1 },
		"systemPrompt": {
			"anyOf": [
				{ "type": "string", "minLength": 1 },
				{
					"type": "object",
					"properties": { "file": { "type": "string", "minLength": 1 } },
					"required": ["file"],
					"additionalProperties": false
				}
			]
		},
		"env": {
			"type": "object",
			"propertyNames": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
			"additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
		},
		"connectors": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"slot": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
					"permissions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"tool": { "type": "string", "minLength": 1 },
								"decision": { "type": "string", "enum": ["always_allow", "ask", "always_deny"] }
							},
							"required": ["tool", "decision"],
							"additionalProperties": false
						}
					}
				},
				"required": ["slot"],
				"additionalProperties": false
			}
		},
		"apps": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"slot": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
					"permissions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"method": { "type": "string", "minLength": 1 },
								"path": { "type": "string", "minLength": 1 },
								"decision": { "type": "string", "enum": ["always_allow", "ask", "always_deny"] }
							},
							"required": ["method", "path", "decision"],
							"additionalProperties": false
						}
					}
				},
				"required": ["slot"],
				"additionalProperties": false
			}
		},
		"skills": {
			"type": "array",
			"items": {
				"anyOf": [
					{ "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
					{
						"type": "object",
						"properties": { "slot": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
						"required": ["slot"],
						"additionalProperties": false
					}
				]
			}
		}
	},
	"required": ["slug", "name", "systemPrompt"],
	"additionalProperties": false
}
